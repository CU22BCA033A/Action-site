# Copy this file to .env.local and fill in every value. .env.local is never committed.
# Full instructions: docs/launch.md

# Admin sign-in. The username is any name you choose.
ADMIN_USERNAME=
# Run: npm run hash-password   then paste the .env.local line it prints.
ADMIN_PASSWORD_HASH=

# Two different random values of at least 32 characters each.
# Create them with: openssl rand -hex 32
SESSION_SECRET=
CODE_PEPPER=

# Supabase project (Free plan). Settings > API and Settings > Database.
# Use the "Transaction pooler" connection string for DATABASE_URL.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

